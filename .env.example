# Copy to `.env` and fill in values. Do not commit `.env`.
# For Docker Hub images: bake only non-secrets at build (e.g. NEXT_PUBLIC_SERVER_URL);
# pass secrets at container runtime on the VPS.

# --- Runtime (required in production) ---
# Postgres connection (Payload). On VPS, point at your DB host (often a service name like `postgres:5432`).
DATABASE_URL=postgres://user:password@host:5432/database

# Payload signing secret (min 32 characters). Generate for production: openssl rand -base64 48
PAYLOAD_SECRET=local-dev-only-do-not-use-in-production-32chars-min

# Public site URL (used in URLs, CORS, and client bundles when set at build time).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Runtime (optional) ---
# Draft preview token (must match the secret configured in the admin preview URL).
PREVIEW_SECRET=

# Bearer token for job runner / cron HTTP calls when no user session.
CRON_SECRET=

# --- Local docker-compose Postgres (optional overrides) ---
POSTGRES_USER=payload
POSTGRES_PASSWORD=payload
POSTGRES_DB=journalism
# Host port mapped to Postgres (see docker-compose.yml). Use this in DATABASE_URL from your machine, e.g.:
# DATABASE_URL=postgres://payload:payload@127.0.0.1:5433/journalism
POSTGRES_HOST_PORT=5433

# --- Docker image build (local) ---
# Image name/tag for buildx (optional; script has a default).
DOCKER_IMAGE=youruser/journalism:1.0.0
# Optional: separate 32+ char secret used only during `scripts/docker-build-amd64.sh` (avoids coupling to runtime secret).
# PAYLOAD_SECRET_BUILD=
# The build script loads this repo’s `.env` automatically (same vars as above apply unless you override in the shell).

# 1. `docker compose up -d postgres`
# 2. Apply schema: `DATABASE_URL=postgres://payload:payload@127.0.0.1:${POSTGRES_HOST_PORT:-5433}/journalism` plus PAYLOAD_SECRET → `pnpm payload migrate`
# 3. Cross-build linux/amd64 (recommended from Mac): `chmod +x scripts/docker-build-amd64.sh && ./scripts/docker-build-amd64.sh` (add `--push` to push to the registry).
#    If `docker compose build app` fails with BuildKit / network:service:postgres, use the script or DOCKER.md Path A / B.
